# Django — SECRET_KEY is required (no insecure default). Generate a long random string.
SECRET_KEY=
# Local development: set DEBUG=True in your private .env (never commit real .env).
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins for production admin, e.g. https://agent.example.com
CSRF_TRUSTED_ORIGINS=
# Operator UI (Next.js). Session cookies + CSRF need these exact origins.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set True on Railway when Phone Desk is on another domain (e.g. Vercel).
# CROSS_SITE_COOKIES=True

# PostgreSQL — local Docker example (password is local-dev only; not for production):
# POSTGRES_DB=phone_agent
# POSTGRES_USER=phone_agent
# POSTGRES_PASSWORD=phone_agent_dev
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=disable

# PostgreSQL — Supabase direct (fill from dashboard; never commit real .env)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Optional full URL (encode special chars in password, e.g. ) -> %29)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase API (optional until you use Supabase client SDKs)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Celery / Redis (Phase 6 enrichment)
# Prefer redis://:PASSWORD@127.0.0.1:6379/0 if Redis requires auth.
REDIS_URL=redis://127.0.0.1:6379/0

# Phase 7 orchestration (comma-separated)
ORCHESTRATION_CITIES=Austin,Dallas,Houston,San Antonio
ORCHESTRATION_CATEGORIES=restaurant,cafe
ORCHESTRATION_LIMIT=25
SCRAPER_LOOP_SLEEP_SECONDS=10

# Phase 9 hardening
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
SOURCE_ERROR_COOLDOWN_MINUTES=60
AUTHORIZED_CRAWL_DELAY_SECONDS=1.5
AUTHORIZED_CRAWL_USER_AGENT=PhoneCollectionAgent/0.1 (authorized-crawl; contact=you@example.com)

# Production HTTPS (applied when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# USE_PROXY_SSL_HEADER=False

# Optional API keys (referenced by DataSource.api_key_env_var — Phase 5+)
# Never commit real values. Rotate any key that appeared in logs or chat.
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
MYTOMTOM_API_KEY=
DIALCODE_API_KEY=

# OpenStreetMap / Overpass (Phase 3)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_USER_AGENT=PhoneCollectionAgent/0.1 (local-dev; contact=you@example.com)
